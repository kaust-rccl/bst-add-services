Bootstrap: docker
From: ubuntu:22.04

%post
    # Update and install basic dependencies
    apt-get update && apt-get install -y --no-install-recommends \
         python3 python3-pip python3-dev build-essential \
         wget ca-certificates git openmpi-bin libopenmpi-dev && \
         rm -rf /var/lib/apt/lists/*

    # Upgrade pip
    python3 -m pip install --upgrade pip

    # Install PyTorch CPU-only and related packages
    python3 -m pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu
    python3 -m pip install deepspeed transformers

%environment
    export LC_ALL=C
    export LANG=C
    # Ensure that CUDA is disabled (though our image is CPU-only)
    export CUDA_VISIBLE_DEVICES=""

%runscript
    # This runscript passes all command-line arguments into the container’s shell
    exec "$@"

